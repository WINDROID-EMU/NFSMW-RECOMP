<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#40FFB800">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#CC141414" />
            <stroke
                android:width="1.5dp"
                android:color="#B3FFB800" />
            <corners android:radius="6dp" />
            <padding
                android:left="18dp"
                android:top="10dp"
                android:right="18dp"
                android:bottom="10dp" />
        </shape>
    </item>
</ripple>
