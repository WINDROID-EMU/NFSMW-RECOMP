<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/dialog_settings_bg"
    android:padding="16dp">

    <!-- Cabeçalho do Diálogo -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingBottom="12dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="⚙ CONFIGURAÇÕES DO JOGO &amp; RUNTIME"
            android:textColor="@color/nfsmw_amber"
            android:textSize="17sp"
            android:textStyle="bold"
            android:letterSpacing="0.04" />

        <Button
            android:id="@+id/btn_close_settings"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/rom_button_bg"
            android:text="✕"
            android:textColor="@color/nfsmw_amber"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#40FFB800"
        android:layout_marginBottom="10dp" />

    <!-- Conteúdo Rolável -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="16dp">

            <!-- ========================================================= -->
            <!-- SEÇÃO 1: VÍDEO & PERFORMANCE                              -->
            <!-- ========================================================= -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📺 VÍDEO E PERFORMANCE"
                android:textColor="@color/nfsmw_amber_light"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="6dp" />

            <!-- Resolução -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Resolução de Saída:"
                android:textColor="#E0E0E0"
                android:textSize="12sp"
                android:layout_marginBottom="2dp" />

            <Spinner
                android:id="@+id/sp_resolution"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:background="@drawable/spinner_bg"
                android:layout_marginBottom="10dp" />

            <!-- Resolução Interna (Supersampling) -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Resolução Interna do Motor (Supersampling):"
                android:textColor="#E0E0E0"
                android:textSize="12sp"
                android:layout_marginBottom="2dp" />

            <Spinner
                android:id="@+id/sp_resolution_scale"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:background="@drawable/spinner_bg"
                android:layout_marginBottom="10dp" />

            <!-- V-Sync -->
            <Switch
                android:id="@+id/sw_vsync"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Sincronização Vertical (V-Sync)"
                android:textColor="#E0E0E0"
                android:textSize="13sp"
                android:paddingTop="6dp"
                android:paddingBottom="6dp" />

            <!-- Tela Estendida / Preencher Tela -->
            <Switch
                android:id="@+id/sw_stretch_screen"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Tela Estendida (Preencher Toda a Tela)"
                android:textColor="#E0E0E0"
                android:textSize="13sp"
                android:paddingTop="6dp"
                android:paddingBottom="2dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="ℹ Elimina barras pretas esticando o jogo conforme a proporção do aparelho."
                android:textColor="#A0A0A0"
                android:textSize="10sp"
                android:layout_marginBottom="8dp" />

            <!-- Divisor -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#20FFFFFF"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="12dp" />

            <!-- ========================================================= -->
            <!-- SEÇÃO 2: MOTOR GRÁFICO & VULKAN (ReXGlue)                 -->
            <!-- ========================================================= -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⚡ MOTOR GRÁFICO &amp; VULKAN (ReXGlue)"
                android:textColor="@color/nfsmw_amber_light"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_marginBottom="6dp" />

            <!-- Caminho da EDRAM -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Emulação da EDRAM do Xenos:"
                android:textColor="#E0E0E0"
                android:textSize="12sp"
                android:layout_marginBottom="2dp" />

            <Spinner
                android:id="@+id/sp_edram_path"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:background="@drawable/spinner_bg"
                android:layout_marginBottom="4dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="ℹ O modo 'rtv' (FBO) duplica a taxa de quadros e é altamente recomendado para celulares."
                android:textColor="#A0A0A0"
                android:textSize="10sp"
                android:layout_marginBottom="10dp" />

            <!-- Async Shaders -->
            <Switch
                android:id="@+id/sw_async_shaders"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Compilação Assíncrona de Shaders"
                android:textColor="#E0E0E0"
                android:textSize="13sp"
                android:paddingTop="6dp"
                android:paddingBottom="2dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="ℹ Compila pipelines em segundo plano para reduzir travamentos no jogo."
                android:textColor="#A0A0A0"
                android:textSize="10sp"
                android:layout_marginBottom="8dp" />

            <!-- Vulkan Async Skip Incomplete Frames -->
            <Switch
                android:id="@+id/sw_async_skip"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Pular Quadros com Shaders Incompletos"
                android:textColor="#E0E0E0"
                android:textSize="13sp"
                android:paddingTop="6dp"
                android:paddingBottom="2dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="ℹ Evita quedas repentinas de FPS quando novos efeitos são compilados na pista."
                android:textColor="#A0A0A0"
                android:textSize="10sp"
                android:layout_marginBottom="10dp" />

            <!-- Pipeline Creation Threads -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Threads de Compilação Vulkan (Pipelines):"
                android:textColor="#E0E0E0"
                android:textSize="12sp"
                android:layout_marginBottom="2dp" />

            <Spinner
                android:id="@+id/sp_pipeline_threads"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:background="@drawable/spinner_bg"
                android:layout_marginBottom="2dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="ℹ 2 Threads economiza bateria e evita aquecimento; 4 Threads compila mais rápido."
                android:textColor="#A0A0A0"
                android:textSize="10sp"
                android:layout_marginBottom="10dp" />

            <!-- Limite de Memória de Texturas (texture_cache_memory_limit_soft) -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Limite de Memória do Cache de Texturas:"
                android:textColor="#E0E0E0"
                android:textSize="12sp"
                android:layout_marginBottom="2dp" />

            <Spinner
                android:id="@+id/sp_texture_cache_limit"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:background="@drawable/spinner_bg"
                android:layout_marginBottom="2dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="ℹ 256MB ou 384MB previne fechamentos forçados por falta de RAM no Android em celulares de 4GB a 6GB."
                android:textColor="#A0A0A0"
                android:textSize="10sp"
                android:layout_marginBottom="10dp" />

            <!-- Conversão de Textura 3D para 2D -->
            <Switch
                android:id="@+id/sw_gpu_3d_to_2d"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Otimizar Texturas 3D para 2D (gpu_3d_to_2d)"
                android:textColor="#E0E0E0"
                android:textSize="13sp"
                android:paddingTop="6dp"
                android:paddingBottom="2dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="ℹ Economiza largura de banda de memória gráfica em GPUs móveis Adreno e Mali."
                android:textColor="#A0A0A0"
                android:textSize="10sp"
                android:layout_marginBottom="10dp" />

            <!-- Readback Resolve -->
            <Switch
                android:id="@+id/sw_readback_resolve"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Efeitos de Pós-Processamento / Bloom (readback_resolve)"
                android:textColor="#E0E0E0"
                android:textSize="13sp"
                android:paddingTop="6dp"
                android:paddingBottom="2dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="ℹ Desativar alivia bastante a GPU e eleva a taxa de quadros (FPS) no Android."
                android:textColor="#A0A0A0"
                android:textSize="10sp"
                android:layout_marginBottom="10dp" />

            <!-- Filtragem Anisotrópica -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Filtragem Anisotrópica (Nitidez no Asfalto):"
                android:textColor="#E0E0E0"
                android:textSize="12sp"
                android:layout_marginBottom="2dp" />

            <Spinner
                android:id="@+id/sp_anisotropic"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:background="@drawable/spinner_bg"
                android:layout_marginBottom="10dp" />

            <!-- Anti-Aliasing -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Anti-Aliasing (FXAA):"
                android:textColor="#E0E0E0"
                android:textSize="12sp"
                android:layout_marginBottom="2dp" />

            <Spinner
                android:id="@+id/sp_antialiasing"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:background="@drawable/spinner_bg"
                android:layout_marginBottom="10dp" />

            <!-- MSAA Nativo 2x -->
            <Switch
                android:id="@+id/sw_native_msaa"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="MSAA Nativo 2x (Anti-Serrilhado de Geometria)"
                android:textColor="#E0E0E0"
                android:textSize="13sp"
                android:paddingTop="6dp"
                android:paddingBottom="2dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="ℹ Suavização poligonal. Mantenha desativado em celulares intermediários."
                android:textColor="#A0A0A0"
                android:textSize="10sp"
                android:layout_marginBottom="10dp" />

            <!-- Divisor -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#20FFFFFF"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="12dp" />

            <!-- ========================================================= -->
            <!-- SEÇÃO 3: ÁUDIO & CONTROLES                                -->
            <!-- ========================================================= -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🔊 ÁUDIO &amp; CONTROLES"
                android:textColor="@color/nfsmw_amber_light"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_marginBottom="6dp" />

            <!-- Silenciar Áudio -->
            <Switch
                android:id="@+id/sw_audio_mute"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Silenciar Todo o Áudio do Jogo"
                android:textColor="#E0E0E0"
                android:textSize="13sp"
                android:paddingTop="6dp"
                android:paddingBottom="6dp" />

            <!-- Teclado/Mouse MNK -->
            <Switch
                android:id="@+id/sw_mnk_mode"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Ativar Entrada de Teclado e Mouse Físicos"
                android:textColor="#E0E0E0"
                android:textSize="13sp"
                android:paddingTop="6dp"
                android:paddingBottom="10dp" />

            <!-- Divisor -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#20FFFFFF"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="12dp" />

            <!-- ========================================================= -->
            <!-- SEÇÃO 4: JOGO & SISTEMA                                   -->
            <!-- ========================================================= -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🏎️ JOGO &amp; SISTEMA"
                android:textColor="@color/nfsmw_amber_light"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_marginBottom="6dp" />

            <!-- Black Edition -->
            <Switch
                android:id="@+id/sw_black_edition"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Desbloquear Conteúdo Black Edition (Carros Bônus)"
                android:textColor="#E0E0E0"
                android:textSize="13sp"
                android:paddingTop="6dp"
                android:paddingBottom="6dp" />

            <!-- Privilégios Online -->
            <Switch
                android:id="@+id/sw_grant_privileges"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Privilégios de Conta Xbox Live Gold"
                android:textColor="#E0E0E0"
                android:textSize="13sp"
                android:paddingTop="6dp"
                android:paddingBottom="10dp" />

            <!-- Gamertag -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Gamertag do Jogador:"
                android:textColor="#E0E0E0"
                android:textSize="12sp"
                android:layout_marginBottom="2dp" />

            <EditText
                android:id="@+id/et_gamertag"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:background="@drawable/spinner_bg"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:hint="Player"
                android:textColorHint="#808080"
                android:singleLine="true"
                android:maxLength="15"
                android:layout_marginBottom="10dp" />

            <!-- Nível de Log do Runtime -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Nível de Registro / Logs do Runtime:"
                android:textColor="#E0E0E0"
                android:textSize="12sp"
                android:layout_marginBottom="2dp" />

            <Spinner
                android:id="@+id/sp_log_level"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:background="@drawable/spinner_bg"
                android:layout_marginBottom="2dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="ℹ 'Erro (Desempenho)' desativa logs desnecessários reduzindo overhead de gravação no Android."
                android:textColor="#A0A0A0"
                android:textSize="10sp"
                android:layout_marginBottom="10dp" />

            <!-- Velocidade do Jogo -->
            <TextView
                android:id="@+id/tv_speed_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Velocidade da Simulação: 100%"
                android:textColor="#E0E0E0"
                android:textSize="12sp"
                android:layout_marginBottom="2dp" />

            <SeekBar
                android:id="@+id/sb_game_speed"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:min="20"
                android:max="200"
                android:progress="100"
                android:layout_marginBottom="16dp" />

        </LinearLayout>
    </ScrollView>

    <!-- Divisor Inferior -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#40FFB800"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="12dp" />

    <!-- Botões de Ação Inferiores -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center">

        <Button
            android:id="@+id/btn_reset_defaults"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:background="@drawable/rom_button_bg"
            android:text="🔄 PADRÕES ANDROID"
            android:textColor="#CCCCCC"
            android:textSize="11sp"
            android:textStyle="bold"
            android:layout_marginEnd="8dp" />

        <Button
            android:id="@+id/btn_save_settings"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1.4"
            android:background="@drawable/start_button_bg"
            android:text="💾 SALVAR E APLICAR"
            android:textColor="@color/nfsmw_black"
            android:textSize="12sp"
            android:textStyle="bold"
            android:layout_marginStart="8dp" />
    </LinearLayout>

</LinearLayout>
